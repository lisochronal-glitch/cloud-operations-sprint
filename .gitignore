# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json

# Terraform crash and override files
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lambda export artifacts
*.zip
lambda-config-full.json
**/env.json
